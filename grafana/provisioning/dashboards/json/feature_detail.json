    {
      "id": 16,
      "type": "table",
      "title": "Mọi metric của $view.$feature · snapshot mới nhất",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH last AS (SELECT max(snapshot_ts) AS ts FROM latest_snapshot_runs WHERE $__timeFilter(snapshot_ts))\nSELECT m.metric_name AS metric, m.value, m.warn_threshold AS warn, m.fail_threshold AS fail, m.status,\n       m.severity, m.baseline_ref, m.detail\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id), last\nWHERE m.feature_view = '$view' AND (m.feature = '$feature' OR m.feature IS NULL) AND m.snapshot_ts = last.ts\nORDER BY m.feature NULLS FIRST, m.metric_name"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "pass": {
                  "color": "green",
                  "index": 0
                },
                "warn": {
                  "color": "yellow",
                  "index": 1
                },
                "fail": {
                  "color": "red",
                  "index": 2
                },
                "published": {
                  "color": "green",
                  "index": 3
                },
                "quarantined": {
                  "color": "red",
                  "index": 4
                },
                "failed_after_gate": {
                  "color": "purple",
                  "index": 5
                },
                "failed": {
                  "color": "dark-red",
                  "index": 6
                },
                "running": {
                  "color": "blue",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"

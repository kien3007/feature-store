          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT m.snapshot_ts AS time, m.value AS \"null_rate\", m.warn_threshold AS \"warn\", m.fail_threshold AS \"fail\"\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id)\nWHERE m.feature_view = '$view' AND m.feature = '$feature' AND m.metric_name = 'null_rate'\n  AND $__timeFilter(m.snapshot_ts)\nORDER BY 1"
        }
      ],

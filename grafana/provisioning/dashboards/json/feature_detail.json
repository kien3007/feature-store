    {
      "id": 15,
      "type": "table",
      "title": "PSI cao nhất · snapshot mới nhất trong khoảng",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "WITH last AS (SELECT max(snapshot_ts) AS ts FROM latest_snapshot_runs WHERE $__timeFilter(snapshot_ts))\nSELECT m.feature_view AS view, m.feature, round(m.value::numeric, 4) AS psi, m.status\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id), last\nWHERE m.metric_name = 'psi' AND m.snapshot_ts = last.ts\nORDER BY m.value DESC NULLS LAST LIMIT 15"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "pass": {
                  "color": "green",
                  "index": 0
                },
                "warn": {
                  "color": "yellow",
                  "index": 1
                },
                "fail": {
                  "color": "red",
                  "index": 2
                },
                "published": {
                  "color": "green",
                  "index": 3
                },
                "quarantined": {
                  "color": "red",
                  "index": 4
                },
                "failed_after_gate": {
                  "color": "purple",
                  "index": 5
                },
                "failed": {
                  "color": "dark-red",
                  "index": 6
                },
                "running": {
                  "color": "blue",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "psi"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "max",
                "value": 0.3
              },
              {
                "id": "thresholds",
                "value": {

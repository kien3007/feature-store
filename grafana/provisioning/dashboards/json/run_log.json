  "panels": [
    {
      "id": 16,
      "type": "table",
      "title": "snapshot_runs",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT to_char(snapshot_ts, 'YYYY-MM-DD') AS snapshot, status, health, trigger, fault,\n       round(duration_s::numeric, 1) AS \"duration (s)\", row_count, materialized, reason,\n       report_url AS report, approved_by, approval_reason, git_sha, feast_version,\n       started_at, finished_at, left(run_id, 8) AS run\nFROM snapshot_runs WHERE $__timeFilter(snapshot_ts)\nORDER BY started_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "pass": {
                  "color": "green",
                  "index": 0
                },
                "warn": {
                  "color": "yellow",
                  "index": 1
                },
                "fail": {
                  "color": "red",
                  "index": 2
                },
                "published": {
                  "color": "green",
                  "index": 3
                },
                "quarantined": {
                  "color": "red",
                  "index": 4
                },
                "failed_after_gate": {
                  "color": "purple",
                  "index": 5
                },
                "failed": {
                  "color": "dark-red",
                  "index": 6
                },
                "running": {
                  "color": "blue",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "custom.width",
                "value": 140
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 70
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "report"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Báo cáo Evidently",
                    "url": "${__value.raw}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "reason"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 17,
      "type": "table",
      "title": "Check warn/fail (lý do)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 14,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT to_char(m.snapshot_ts, 'YYYY-MM-DD') AS snapshot, m.feature_view AS view, m.feature, m.metric_name AS metric,\n       m.value, m.warn_threshold AS warn, m.fail_threshold AS fail, m.status, m.severity, m.detail\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id)\nWHERE m.status IN ('warn', 'fail') AND $__timeFilter(m.snapshot_ts)\nORDER BY m.snapshot_ts DESC, m.status, m.feature_view"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "pass": {
                  "color": "green",
                  "index": 0
                },
                "warn": {
                  "color": "yellow",
                  "index": 1
                },
                "fail": {
                  "color": "red",
                  "index": 2
                },
                "published": {
                  "color": "green",
                  "index": 3
                },
                "quarantined": {
                  "color": "red",
                  "index": 4
                },
                "failed_after_gate": {
                  "color": "purple",
                  "index": 5
                },
                "failed": {
                  "color": "dark-red",
                  "index": 6
                },
                "running": {
                  "color": "blue",
                  "index": 7
                }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {}
    },
    {
      "id": 18,
      "type": "table",
      "title": "Lịch sử duyệt tay",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 14,
        "y": 12,
        "w": 10,

      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT to_char(snapshot_ts, 'YYYY-MM-DD') AS snapshot, approved_by, approval_reason, approved_at, status\nFROM snapshot_runs WHERE approved_by IS NOT NULL ORDER BY approved_at DESC"

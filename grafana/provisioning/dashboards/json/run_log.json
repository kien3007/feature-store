    {
      "id": 19,
      "type": "timeseries",
      "title": "Thời gian xử lý mỗi run (s)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT m.snapshot_ts AS time, m.value AS run_duration_s, m.warn_threshold AS warn\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id)\nWHERE m.metric_name = 'run_duration_s' AND $__timeFilter(m.snapshot_ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "online_match_rate và p95 get_online_features",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT m.snapshot_ts AS time, min(m.value) AS online_match_rate\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id)\nWHERE m.metric_name = 'online_match_rate' AND $__timeFilter(m.snapshot_ts) GROUP BY 1 ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT m.snapshot_ts AS time, m.value AS p95_ms\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id)\nWHERE m.metric_name = 'online_get_p95_ms' AND $__timeFilter(m.snapshot_ts) ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "online_match_rate"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0.98
              },
              {
                "id": "max",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95_ms"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {}
    }

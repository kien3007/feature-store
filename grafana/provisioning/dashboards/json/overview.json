      "type": "timeseries",
      "title": "Độ tươi nguồn (giờ)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT m.snapshot_ts AS time, max(m.value) AS freshness_lag, max(m.warn_threshold) AS warn,\n       max(m.fail_threshold) AS fail\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id)\nWHERE m.metric_name = 'freshness_lag' AND $__timeFilter(m.snapshot_ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "h",
          "custom": {
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": [

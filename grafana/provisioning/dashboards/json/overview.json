          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT to_char(snapshot_ts, 'YYYY-MM-DD') AS snapshot, status, health, trigger, fault,\n       round(duration_s::numeric, 1) AS \"duration (s)\", reason, report_url AS report, finished_at\nFROM snapshot_runs ORDER BY started_at DESC LIMIT 10"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "pass": {
                  "color": "green",

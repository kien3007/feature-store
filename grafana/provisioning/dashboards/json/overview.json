                },
                "warn": {
                  "color": "yellow",
                  "index": 1
                },
                "fail": {
                  "color": "red",
                  "index": 2
                },
                "published": {
                  "color": "green",
                  "index": 3
                },
                "quarantined": {
                  "color": "red",
                  "index": 4
                },

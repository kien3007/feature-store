    {
      "id": 8,
      "type": "timeseries",
      "title": "Số dòng theo view",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT m.snapshot_ts AS time, m.feature_view AS metric, m.value\nFROM snapshot_metrics m JOIN latest_snapshot_runs r USING (run_id)\nWHERE m.metric_name = 'row_count' AND $__timeFilter(m.snapshot_ts) ORDER BY 1"
        }

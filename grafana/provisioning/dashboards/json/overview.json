    {
      "id": 1,
      "type": "state-timeline",
      "title": "Sức khỏe snapshot theo feature view",
      "description": "Run mới nhất của mỗi snapshot_ts. fail = có check blocker fail (bị chặn); warn = publish kèm cảnh báo.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "fsmon-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "fsmon-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT snapshot_ts AS time, '» snapshot' AS metric,\n       CASE health WHEN 'pass' THEN 0 WHEN 'warn' THEN 1 ELSE 2 END AS value\nFROM latest_snapshot_runs WHERE $__timeFilter(snapshot_ts)\nUNION ALL\nSELECT snapshot_ts, feature_view, CASE health WHEN 'pass' THEN 0 WHEN 'warn' THEN 1 ELSE 2 END\nFROM view_health WHERE $__timeFilter(snapshot_ts)\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "pass",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "warn",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "fail",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 1,
            "insertNulls": 90000000
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": false,
        "rowHeight": 0.85,
        "alignValue": "center",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
